<IfModule mod_rewrite.c>
RewriteEngine on

RewriteRule ^admin-ikm.html$ home.php [L]
RewriteRule ^logout.html$ web-view.php [L]
RewriteRule ^home.html$ home.php [L]

</IfModule>

# secure htaccess file
<Files .htaccess>
order allow,deny
deny from all
#allow from env=ajax
</Files>

options All -Indexes