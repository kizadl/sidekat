<IfModule mod_rewrite.c>
RewriteEngine on

RewriteRule ^login.html$ ../admin/login.php [L]
RewriteRule ^arsip_rdp.html$ ../admin/arsip_rdp.php [L]
RewriteRule ^arsip_kunjungan_kerja.html$ ../admin/arsip_kunjungan_kerja.php [L]
RewriteRule ^arsip_magang.html$ ../admin/arsip_magang.php [L]
RewriteRule ^arsip_penelitian.html$ ../admin/arsip_penelitian.php [L]
RewriteRule ^arsip_studi_edukasi.html$ ../admin/arsip_studi_edukasi.php [L]
RewriteRule ^verifikasi_rdp.html$ ../admin/verifikasi_rdp.php [L]
RewriteRule ^verifikasi_magang.html$ ../admin/verifikasi_magang.php [L]
RewriteRule ^verifikasi_penelitian.html$ ../admin/verifikasi_penelitian.php [L]
RewriteRule ^verifikasi_studi_edukasi.html$ ../admin/verifikasi_studi_edukasi.php [L]
RewriteRule ^verifikasi_kunjungan_kerja.html$ ../admin/verifikasi_kunjungan_kerja.php [L]
RewriteRule ^kategori_instansi.html$ ../admin/kategori_instansi.php [L]
RewriteRule ^dashboard.html$ ../admin/dashboard.php [L]
RewriteRule ^pengaturan_kuota.html$ ../admin/pengaturan_kuota.php [L]
RewriteRule ^ikm_pendidikan.html$ ../admin/ikm_pendidikan.php [L]
RewriteRule ^ikm_pekerjaan.html$ ../admin/ikm_pekerjaan.php [L]
RewriteRule ^ikm_unsur.html$ ../admin/ikm_unsur.php [L]
RewriteRule ^ikm_soal.html$ ../admin/ikm_soal.php [L]



</IfModule>

# secure htaccess file
<Files .htaccess>
order allow,deny
deny from all
#allow from env=ajax
</Files>

options All -Indexes